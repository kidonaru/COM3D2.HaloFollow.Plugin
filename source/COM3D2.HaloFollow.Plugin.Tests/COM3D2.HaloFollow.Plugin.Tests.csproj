<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9</LangVersion>
    <IsPackable>false</IsPackable>
    <COM3D25_DIR Condition=" '$(COM3D25_DIR)' == '' ">W:\COM3D2_5</COM3D25_DIR>
    <ManagedDir>$(COM3D25_DIR)\COM3D2x64_Data\Managed</ManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\COM3D2.HaloFollow.Plugin\COM3D2.HaloFollow.Plugin.csproj" />
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <!-- MTEUtils の静的初期化子が CharacterMgr の型を引くため、KeyBind など MTEUtils に触れるテストで要る（SceneEditor のテストと同じ） -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
    </Reference>
    <None Include="$(ManagedDir)\Assembly-CSharp-firstpass.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\..\config-example\HaloFollow.xml" Link="HaloFollow.xml" CopyToOutputDirectory="PreserveNewest" />
    <!-- netstandard.dll は Unity の 2.1 facade。UnityEngine.CoreModule が netstandard 2.1 を要求するため実行時に必要 -->
    <None Include="$(ManagedDir)\netstandard.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
