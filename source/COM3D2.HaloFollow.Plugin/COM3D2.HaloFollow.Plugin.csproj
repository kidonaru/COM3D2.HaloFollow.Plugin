<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net471</TargetFramework>
    <AssemblyName>COM3D2.HaloFollow</AssemblyName>
    <RootNamespace>COM3D2.HaloFollow.Plugin</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <!-- バージョンの単一ソースは PluginInfo.cs（bump-version.bat が書き換える） -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- ゲームのインストール先。build.bat が .env から /p:COM3D25_DIR= で渡す -->
    <COM3D25_DIR Condition=" '$(COM3D25_DIR)' == '' ">W:\COM3D2_5</COM3D25_DIR>
    <GameDir>$(COM3D25_DIR)</GameDir>
    <ManagedDir>$(GameDir)\COM3D2x64_Data\Managed</ManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="COM3D2.HaloFollow.Plugin.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(ManagedDir)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
